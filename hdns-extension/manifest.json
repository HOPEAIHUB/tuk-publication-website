{
  "manifest_version": 3,
  "name": "HDNS — Hope AI Sovereign DNS Redirect",
  "version": "2.0.0",
  "description": "Redirects .core, .gag, .gap, .hope, .thimothism, .tuk, .otp, .tuidl, .hs, .hpls, .bank, .finance, .tuic, .tup, .hmtml to the public HOPE AI gateway.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequest", "storage", "webRequest"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "sovereign_tld_rules",
      "enabled": true,
      "path": "dns-rules.json"
    }]
  }
}
