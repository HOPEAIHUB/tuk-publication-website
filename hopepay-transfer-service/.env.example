# === TRON NETWORK ===
# Use "mainnet" for real transfers, "nile" for testnet
TRON_NETWORK=mainnet

# === WALLET ===
# The sender address (public — safe to share)
SENDER_ADDRESS=TATaPsa8c7DhicJ6wruQw1dADGvmiJHkRX

# The private key (SECRET — 64 hex characters)
# ⚠️  FILL THIS IN YOURSELF — never let anyone else do it
# ⚠️  Never share this with anyone, including AI agents
# ⚠️  If leaked, move all funds immediately
SENDER_PRIVATE_KEY=

# === USDT CONTRACT ===
# TRON mainnet USDT contract (Tether USD)
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# === API SECURITY ===
# API key required for /transfer endpoint
# Change this to something unique
TRANSFER_API_KEY=hopepay-tuk-sovereign-2026

# === SERVER ===
PORT=3000
